{
  "version": 2,
  "builds": [
    {
      "src": "api/agent_fix.py",
      "use": "@vercel/python"
    },
    {
      "src": "web/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/agent_fix",
      "dest": "api/agent_fix.py"
    },
    {
      "src": "/api/agent-fix",
      "dest": "api/agent_fix.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/agent_fix.py"
    },
    {
      "src": "/(.*)",
      "dest": "web/$1"
    }
  ]
}
